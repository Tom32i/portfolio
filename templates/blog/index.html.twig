{% extends 'base.html.twig' %}

{% use 'blog/blocks.html.twig' %}

{% import 'common/json_ld.html.twig' as json_ld %}

{% block meta_title 'blog.meta_title'|trans %}
{% block meta_description 'blog.subtitle'|trans %}
{% block body_class 'page-blog' %}

{% block head %}
    <link rel="alternate" type="application/rss+xml" title="{{ 'blog.meta_title'|trans }}" href="{{ url('blog_feed') }}">
    {# Posts are in French or English: each one states its language. #}
    {{ json_ld.script({
        '@context': 'https://schema.org',
        '@type': 'Blog',
        '@id': url('blog') ~ '#blog',
        url: url('blog'),
        name: 'blog.meta_title'|trans,
        description: 'blog.subtitle'|trans,
        author: author,
        blogPost: articles|map(article => {
            '@type': 'BlogPosting',
            headline: article.title,
            url: url('blog_article', { article: article.slug }),
            datePublished: article.date|date('c'),
            inLanguage: article.language,
        }),
    }) }}
{% endblock %}

{% block body %}
    <header class="page-header wrap">
        <h1>{{ 'blog.title'|trans }}</h1>
        <p>{{ 'blog.subtitle'|trans }}</p>
    </header>

    <main class="section section-posts wrap">
        <ul class="posts">
            {% for article in articles %}
                {{ block('preview') }}
            {% endfor %}
        </ul>
    </main>
{% endblock %}
