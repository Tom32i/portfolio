{% macro link(url, label) %}<a href="{{ url }}">{{ label ?? url|replace({ 'https://': '', 'http://': '', 'www.': '' })|trim('/', 'right') }}</a>{% endmacro %}
{% import _self as cv %}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="robots" content="noindex">
        <title>CV Thomas Jarrand</title>
        {{ encore_entry_link_tags('cv') }}
    </head>
    <body>
        <header class="cv-header">
            <div class="cv-identity">
                <h1>Thomas <strong>Jarrand</strong></h1>
                <p>{{ 'hero.tagline'|trans }}</p>
            </div>
            <img class="cv-portrait" src="{{ asset('/img/portrait.jpg') }}" alt="">
            <ul class="cv-contacts">
                <li>Lyon</li>
                <li>{{ email }}</li>
                <li>{{ cv.link(url('portfolio'), 'thomas.jarrand.fr') }}<br>{{ cv.link(links.github, 'github.com/tom32i') }}<br>{{ cv.link(links.linkedin, 'linkedin.com/in/thomasjarrand') }}</li>
            </ul>
        </header>

        <main>
            <h2 class="cv-job">Lead développeur web</h2>

            <section class="cv-section">
                <h3>Profil</h3>
                <div class="cv-paragraphs">
                    <p>
                        Développeur depuis plus de 15 ans, j’encadre aujourd’hui une équipe au quotidien et je guide les choix produit et techniques aux côtés du métier.
                    </p>
                    <p>
                        Enthousiaste et créatif, je conçois et développe des solutions full-stack performantes, maintenables et orientées produit.
                        J’aime relever les défis techniques exigeants, notamment en performance et en optimisation des coûts.
                        Je travaille principalement en PHP avec Symfony et Laravel, et côté front avec React et Vue. Je fais aussi appel à Go pour les traitements critiques et parallélisés.
                    </p>
                    <p>
                        Je partage mon savoir-faire via les revues de code, des conférences, des articles et des outils open source.
                        Je suis moteur en équipe et j’organise volontiers des game jams et des sorties randonnée entre collègues&nbsp;!
                    </p>
                </div>
            </section>

            <section class="cv-section">
                <h3>Compétences</h3>
                <ul>
                    {% for skill in skills %}
                        <li><strong>{{ skill.label }}&nbsp;:</strong> {{ skill.value }}</li>
                    {% endfor %}
                </ul>
            </section>

            <section class="cv-section">
                <h3>Expérience</h3>
                <div class="cv-entries">
                    {% for job in jobs %}
                        <article class="cv-entry">
                            <p><strong>{{ job.title }}</strong> chez <em>{{ job.company }}{% if job.place is defined %} – {{ job.place }}{% endif %}</em></p>
                            <p><span class="cv-key">Période :</span> {{ job.period }}{% if job.duration is defined %} · <strong>{{ job.duration }}</strong>{% endif %}</p>
                            <p><span class="cv-key">Missions :</span> {{ job.missions }}</p>
                            {% if job.achievements is defined %}
                                <p><span class="cv-key">Réalisations :</span> {{ job.achievements }}</p>
                            {% endif %}
                            {% if job.projects is defined %}
                                <p><span class="cv-key">Projets :</span> lead sur {% for name, url in job.projects %}{{ cv.link(url, name) }}{{ loop.revindex0 > 1 ? ', ' : (loop.revindex0 == 1 ? ' et ' : '.') }}{% endfor %}</p>
                            {% endif %}
                            <p><span class="cv-key">Structure :</span> {% if job.url is defined %}{{ cv.link(job.url) }}, {% endif %}{{ job.structure }}</p>
                        </article>
                    {% endfor %}
                </div>
            </section>

            <section class="cv-section">
                <h3>Études</h3>
                <ul>
                    {% for study in studies %}
                        <li><span class="cv-key">{{ study.years }} :</span> {{ study.what }}</li>
                    {% endfor %}
                </ul>
            </section>

            <section class="cv-section">
                <h3>Créations</h3>
                <div class="cv-entries">
                    <p>
                        J’ai créé les jeux multijoueurs en ligne {{ cv.link('https://curvytron.com', 'Curvytron') }},
                        sa suite en 3D {{ cv.link('https://curvytron2.com', 'Curvytron 2') }}, et {{ cv.link('https://whatthetune.com', 'What the Tune ?!') }}
                    </p>
                    <p>
                        Je maintiens des projets open source comme :<br>
                        {{ cv.link('https://github.com/StenopePHP/Stenope', 'Stenope') }} : un générateur de site statique pour Symfony,<br>
                        {{ cv.link('https://github.com/Tom32i/synchroplayer', 'Synchroplayer') }} : un lecteur vidéo synchronisé pour regarder à plusieurs,<br>
                        {{ cv.link('https://github.com/Tom32i/netcode', 'Netcode') }} : un moteur de communication temps réel pour le web.
                    </p>
                    <p>
                        Je donne des conférences sur des sujets aussi variés que
                        la {{ cv.link('https://talk.tom32i.fr/svg-twig/', 'génération de graphiques SVG avec Symfony') }},
                        les {{ cv.link('https://talk.tom32i.fr/emoji/', 'emojis') }},
                        la {{ cv.link('https://talk.tom32i.fr/vacances-velo/', 'randonnée à vélo') }},
                        la {{ cv.link('https://talk.tom32i.fr/stenope/', 'génération de sites statiques') }}
                        ou encore la {{ cv.link('https://talk.tom32i.fr/binary-brain/', 'lecture d’IRM du cerveau en JavaScript') }}
                        ({{ cv.link('https://youtu.be/LuCXFhaRXcw', 'filmée') }} au Forum PHP 2018).
                    </p>
                </div>
            </section>

            <section class="cv-section">
                <h3>À propos de moi</h3>
                <p>
                    Je me déplace essentiellement à vélo et en longboard.<br>
                    Je suis photographe amateur, jardinier d’appartement, fan de jeux vidéo indépendants, redoutable au blind test et spécialiste du gratin dauphinois.<br>
                    Pour me ressourcer, je pars bivouaquer dans les Alpes, traverser la France à vélo ou encore plonger en apnée en Méditerranée.
                </p>
            </section>
        </main>

        <footer class="cv-footer">
            Jeux, conférences et projets open source sur {{ cv.link(url('portfolio'), 'thomas.jarrand.fr') }}
        </footer>
    </body>
</html>
